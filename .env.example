# Copy to backend/.env (or the repository root .env) and adjust. Never commit real values.

# development | production | test
APP_ENV=development

# SQLite by default; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/studyforge
DATABASE_URL=sqlite:///./data/studyforge.db

# No upload/export directories are needed: uploads are parsed in memory and discarded,
# and exports are generated in memory on request.

# Limits
MAX_UPLOAD_MB=25
MAX_PAGES=400
MAX_DOCUMENTS_PER_WORKSPACE=15
PROCESSING_TIMEOUT_SECONDS=120
UPLOADS_PER_HOUR=20
QUIZZES_PER_HOUR=120
WORKSPACES_PER_HOUR_PER_IP=30

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Expose /docs and /redoc (defaults to on outside production)
# ENABLE_DOCS=true

# Optional local LLM via Ollama. Leave empty to disable (the default).
# Only point this at a server you control: topic passages are sent to it.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# Frontend (frontend/.env.local): backend base URL for production builds.
# Leave empty in development; Vite proxies /api to http://127.0.0.1:8000.
# VITE_API_BASE_URL=https://your-api.onrender.com
